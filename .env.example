# Optional local environment values.
# The app primarily uses config.py for settings.

PYTHONUNBUFFERED=1

# --- Dashboard owner login -------------------------------------------------
# Set a password to enable owner login. When set, the public can VIEW the
# dashboard (read-only) but only the owner can run/upload/refresh/edit.
# REQUIRED before exposing the dashboard with a public Cloudflare link.
# Copy this file to ".env" (which is git-ignored) and fill in a strong password.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Permanent public link (ngrok) -----------------------------------------
# Your fixed ngrok domain, e.g. yourname.ngrok-free.dev (find it at
# ngrok.com -> Gateway -> Domains). Used by serve_public.command. The URL never
# changes across restarts. (Set up ngrok authtoken once: ngrok config add-authtoken <token>)
NGROK_DOMAIN=

# --- TikTok posting (Login Kit + Content Posting API) ----------------------
# From your app in the TikTok developer portal (developers.tiktok.com).
# With these set, the TikTok Candidates page shows "Connect TikTok" and a
# "Post to TikTok" button on each clip (owner-only).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
#
# The OAuth callback URL. Leave blank to auto-derive:
#   - if NGROK_DOMAIN is set  -> https://<NGROK_DOMAIN>/tiktok/callback
#   - otherwise               -> http://localhost:8000/tiktok/callback
# Whatever this resolves to MUST be registered as a Redirect URI in the TikTok
# portal (Login Kit config). The Candidates page shows the exact value to use.
# TIKTOK_REDIRECT_URI=https://yourname.ngrok-free.dev/tiktok/callback
#
# Scopes to enable on the app: user.info.basic and video.publish
# (remove the old video.list scope before submitting for review).
